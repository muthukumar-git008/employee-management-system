# Multi-stage build: compile the Spring Boot backend, then run it in a slim JRE image. FROM maven:3.9-eclipse-temurin-17 AS build WORKDIR /app COPY backend/pom.xml . RUN mvn -q dependency:go-offline COPY backend/src ./src RUN mvn -q clean package -DskipTests FROM eclipse-temurin:17-jre WORKDIR /app COPY --from=build /app/target/*.jar app.jar EXPOSE 8080 ENTRYPOINT ["java", "-jar", "app.jar", "--spring.profiles.active=prod"]
